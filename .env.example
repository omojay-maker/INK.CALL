NODE_ENV=development
PORT=8090
HOST=0.0.0.0
APP_ORIGIN=http://localhost

# Use a separate long random secret. The PHP token endpoint must use the same value.
CALL_JWT_SECRET=replace-with-at-least-32-random-bytes
CALL_JWT_ISSUER=ink-web
CALL_JWT_AUDIENCE=ink-call-service
ADMIN_SERVICE_SECRET=replace-with-the-same-32-character-secret-used-by-admin-and-ai

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=blog_website
DB_USER=ink_calls
DB_PASSWORD=replace-me
DB_POOL_SIZE=10

REDIS_URL=redis://redis:6379

STUN_URL=stun:turn.example.com:3478
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_TLS_URL=turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-a-different-long-random-secret
TURN_TTL_SECONDS=3600
